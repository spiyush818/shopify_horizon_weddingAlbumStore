{% doc %}
  @prompt
    generate one recently viewed products carousel with product image product name product price  products 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recently-viewed-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-recently-viewed-{{ ai_gen_id }}__heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__heading {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__controls {
    display: flex;
    gap: 8px;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__button {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 50%;
    background: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__button:focus-visible,
  .ai-recently-viewed-{{ ai_gen_id }}__card-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__track {
    display: grid;
    grid-auto-columns: calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * 16px)) / {{ block.settings.columns_desktop }});
    grid-auto-flow: column;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    padding-bottom: 8px;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__card {
    min-width: 0;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__media {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f4f4f4;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__media img,
  .ai-recently-viewed-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__title {
    margin: 12px 0 4px;
    font-size: 15px;
    line-height: 1.4;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 14px;
  }

  .ai-recently-viewed-{{ ai_gen_id }}__empty {
    padding: 24px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-recently-viewed-{{ ai_gen_id }} {
      width: 100%;
    }
    .ai-recently-viewed-{{ ai_gen_id }}__track {
      grid-auto-columns: calc((100% - 12px) / 1.5);
    }
    .ai-recently-viewed-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | at_most: 32 }}px;
    }
  }
{% endstyle %}

<recently-viewed-{{ ai_gen_id }} class="ai-recently-viewed-{{ ai_gen_id }}" data-limit="{{ block.settings.product_limit }}" data-storage-key="recently-viewed-products" {{ block.shopify_attributes }}>
  <div class="ai-recently-viewed-{{ ai_gen_id }}__heading-row">
    <h2 class="ai-recently-viewed-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <div class="ai-recently-viewed-{{ ai_gen_id }}__controls" aria-label="Carousel controls">
      <button class="ai-recently-viewed-{{ ai_gen_id }}__button" type="button" data-direction="previous" aria-label="Scroll to previous products"><span aria-hidden="true">&#8592;</span></button>
      <button class="ai-recently-viewed-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="Scroll to next products"><span aria-hidden="true">&#8594;</span></button>
    </div>
  </div>
  <div class="ai-recently-viewed-{{ ai_gen_id }}__track" data-track aria-live="polite"></div>
  <div class="ai-recently-viewed-{{ ai_gen_id }}__empty" data-empty hidden>{{ block.settings.empty_message | escape }}</div>
  <template data-card-template>
    <article class="ai-recently-viewed-{{ ai_gen_id }}__card">
      <a class="ai-recently-viewed-{{ ai_gen_id }}__card-link" data-link>
        <div class="ai-recently-viewed-{{ ai_gen_id }}__media" data-media></div>
        <h3 class="ai-recently-viewed-{{ ai_gen_id }}__title" data-title></h3>
        <p class="ai-recently-viewed-{{ ai_gen_id }}__price" data-price></p>
      </a>
    </article>
  </template>
</recently-viewed-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'recently-viewed-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class RecentlyViewed{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.empty = this.querySelector('[data-empty]');
        this.template = this.querySelector('[data-card-template]');
        this.limit = Number(this.dataset.limit) || 8;
        this.storageKey = this.dataset.storageKey;
        this.renderProducts();
        this.addEventListener('click', (event) => {
          const button = event.target.closest('[data-direction]');
          if (!button) return;
          const distance = this.track.clientWidth * 0.8;
          this.track.scrollBy({ left: button.dataset.direction === 'next' ? distance : -distance, behavior: 'smooth' });
        });
      }

      renderProducts() {
        let records = [];
        try {
          records = JSON.parse(localStorage.getItem(this.storageKey) || '[]');
        } catch (error) {
          records = [];
        }
        records = records.filter((item) => item && item.url && item.title && item.id !== '{{ product.id }}').slice(0, this.limit);
        this.track.replaceChildren();
        records.forEach((item) => {
          const card = this.template.content.firstElementChild.cloneNode(true);
          const link = card.querySelector('[data-link]');
          const media = card.querySelector('[data-media]');
          link.href = item.url;
          card.querySelector('[data-title]').textContent = item.title;
          card.querySelector('[data-price]').textContent = item.price || '';
          if (item.image) {
            const image = document.createElement('img');
            image.src = item.image;
            image.alt = item.imageAlt || item.title;
            image.loading = 'lazy';
            media.appendChild(image);
          } else {
            media.innerHTML = '{{ 'image' | placeholder_svg_tag }}';
          }
          this.track.appendChild(card);
        });
        this.empty.hidden = records.length > 0;
        this.track.hidden = records.length === 0;
        this.querySelectorAll('[data-direction]').forEach((button) => { button.disabled = records.length === 0; });
      }
    }

    customElements.define(tagName, RecentlyViewed{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Recently viewed products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "text", "id": "empty_message", "label": "Empty message", "default": "Products you view will appear here." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "Visible products on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 4 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" }
  ],
  "presets": [{ "name": "Recently viewed products" }],
  "tag": null,
  "class": "recently-viewed-products-block"
}
{% endschema %}