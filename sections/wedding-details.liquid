<section class="wedding-details" style="--wedding-details-bg: {{ section.settings.background_color }};">
  <div class="wedding-details__inner">
    <header class="wedding-details__header">
      {% if section.settings.eyebrow != blank %}<p class="wedding-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    </header>
    <div class="wedding-details__grid">
      {% for block in section.blocks %}
        <article class="wedding-detail" {{ block.shopify_attributes }}>
          {% if block.settings.mark != blank %}<span class="wedding-detail__mark">{{ block.settings.mark | escape }}</span>{% endif %}
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
          {% if block.settings.description != blank %}<p>{{ block.settings.description | escape }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .wedding-details { padding: clamp(64px, 8vw, 108px) clamp(20px, 6vw, 88px); background: var(--wedding-details-bg); }
  .wedding-details__inner { max-width: 1280px; margin: 0 auto; }
  .wedding-details__header { max-width: 680px; margin: 0 auto 50px; text-align: center; }
  .wedding-details__header .wedding-eyebrow { margin: 0 0 14px; color: #80694f; }
  .wedding-details__header h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(36px, 4.2vw, 54px); font-weight: 400; letter-spacing: -.045em; line-height: 1.08; }
  .wedding-details__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: #d9cbbb; border: 1px solid #d9cbbb; }
  .wedding-detail { min-height: 210px; padding: clamp(24px, 4vw, 46px); background: var(--wedding-details-bg); }
  .wedding-detail__mark { color: #92795e; font-size: 10px; letter-spacing: .14em; }
  .wedding-detail h3 { margin: 32px 0 10px; font-family: Georgia, 'Times New Roman', serif; font-size: 25px; font-weight: 400; letter-spacing: -.025em; }
  .wedding-detail p { max-width: 310px; margin: 0; font-size: 12px; line-height: 1.8; opacity: .73; }
  @media (max-width: 749px) {
    .wedding-details { padding: 62px 20px; }
    .wedding-details__header { margin-bottom: 32px; text-align: left; }
    .wedding-details__grid { grid-template-columns: 1fr; }
    .wedding-detail { min-height: 0; padding: 26px; }
    .wedding-detail h3 { margin-top: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wedding details",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE DETAILS MATTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for a lifetime of looking back" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fbf8f3" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "mark", "label": "Number or symbol", "default": "01" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A story-first design" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A thoughtful layout that gives the moments, people, and little details room to shine." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wedding details",
      "blocks": [
        { "type": "detail" },
        { "type": "detail" },
        { "type": "detail" }
      ]
    }
  ]
}
{% endschema %}
