<section
  class="wedding-hero"
  style="--wedding-hero-bg: {{ section.settings.background_color }}; --wedding-hero-text: {{ section.settings.text_color }};"
>
  <div class="wedding-hero__inner">
    <div class="wedding-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="wedding-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="wedding-hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="wedding-hero__description">{{ section.settings.description | escape | newline_to_br }}</div>
      {% endif %}
      <div class="wedding-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="wedding-button wedding-button--dark" href="{{ section.settings.primary_link | default: '#album-collections' }}">
            {{ section.settings.primary_label | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="wedding-text-link" href="{{ section.settings.secondary_link | default: '#our-story' }}">
            {{ section.settings.secondary_label | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </div>
      {% if section.settings.note != blank %}
        <p class="wedding-hero__note"><span aria-hidden="true">✳</span> {{ section.settings.note | escape }}</p>
      {% endif %}
    </div>

    <div class="wedding-hero__visual" style="--wedding-hero-image-position: {{ section.settings.image_position }};">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 52vw, 100vw',
            alt: section.settings.image.alt,
            class: 'wedding-hero__image',
            fetchpriority: 'high'
        }}
      {% else %}
        <div class="wedding-hero__placeholder" role="img" aria-label="Add a wedding album photograph in the theme editor">
          <span class="wedding-hero__placeholder-frame"></span>
          <span class="wedding-hero__placeholder-caption">YOUR STORY, BEAUTIFULLY KEPT</span>
        </div>
      {% endif %}
      <span class="wedding-hero__image-caption">A little piece of forever</span>
      <span class="wedding-hero__seal" aria-hidden="true">made<br>with love</span>
    </div>
  </div>
</section>

{% stylesheet %}
  .wedding-hero {
    background: var(--wedding-hero-bg);
    color: var(--wedding-hero-text);
    padding: clamp(42px, 7vw, 100px) clamp(20px, 6vw, 88px);
  }
  .wedding-hero__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: clamp(40px, 8vw, 120px);
  }
  .wedding-hero__content { max-width: 560px; padding: 20px 0; }
  .wedding-eyebrow {
    margin: 0 0 22px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .2em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .wedding-hero__heading {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(48px, 6.2vw, 88px);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .98;
  }
  .wedding-hero__description {
    max-width: 410px;
    margin-top: 24px;
    font-size: 15px;
    line-height: 1.8;
    opacity: .8;
  }
  .wedding-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 32px; }
  .wedding-button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 0 23px;
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: 12px;
    letter-spacing: .045em;
    text-decoration: none;
    transition: background .2s ease, color .2s ease, transform .2s ease;
  }
  .wedding-button:hover { transform: translateY(-2px); }
  .wedding-button--dark { background: #382f27; color: #fbf8f3; }
  .wedding-button--dark:hover { background: #68523d; color: #fff; }
  .wedding-text-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: inherit;
    font-size: 12px;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 5px;
  }
  .wedding-hero__note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 42px 0 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 14px;
    font-style: italic;
    opacity: .75;
  }
  .wedding-hero__note span { font-size: 17px; }
  .wedding-hero__visual { min-height: 440px; position: relative; }
  .wedding-hero__image, .wedding-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wedding-hero__image { object-position: var(--wedding-hero-image-position, center center); }
  .wedding-hero__placeholder {
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(140deg, #d7c4ae, #eee5d9 48%, #b99576);
  }
  .wedding-hero__placeholder:before {
    content: "";
    position: absolute;
    width: 52%;
    height: 76%;
    border: 1px solid rgb(255 255 255 / 55%);
    background: linear-gradient(145deg, rgb(255 255 255 / 30%), rgb(121 90 60 / 16%));
    box-shadow: 22px 22px 0 rgb(78 57 39 / 12%);
    transform: rotate(-6deg);
  }
  .wedding-hero__placeholder-frame {
    position: absolute;
    width: 39%;
    height: 58%;
    border: 10px solid #f5efe6;
    background: linear-gradient(140deg, #bba082, #e1d2c0 52%, #8e765d);
    transform: rotate(-6deg);
  }
  .wedding-hero__placeholder-caption {
    position: absolute;
    bottom: 20px;
    left: 22px;
    color: #fffaf3;
    font-size: 9px;
    letter-spacing: .2em;
  }
  .wedding-hero__image-caption {
    position: absolute;
    right: 0;
    bottom: -27px;
    color: currentColor;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 12px;
    font-style: italic;
    opacity: .75;
  }
  .wedding-hero__seal {
    position: absolute;
    top: -20px;
    right: -22px;
    width: 86px;
    height: 86px;
    display: grid;
    place-content: center;
    border-radius: 50%;
    background: #f9f4eb;
    color: #705b45;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 14px;
    font-style: italic;
    line-height: 1.05;
    text-align: center;
    transform: rotate(9deg);
  }
  @media (max-width: 749px) {
    .wedding-hero { padding: 42px 20px 62px; }
    .wedding-hero__inner { grid-template-columns: 1fr; gap: 36px; }
    .wedding-hero__content { padding: 0; }
    .wedding-hero__heading { max-width: 520px; font-size: clamp(48px, 14vw, 72px); }
    .wedding-hero__note { margin-top: 28px; }
    .wedding-hero__visual { min-height: min(105vw, 470px); margin-right: 12px; }
    .wedding-hero__seal { width: 72px; height: 72px; right: -12px; font-size: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wedding hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MADE FOR YOUR FOREVER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep your forever close." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Turn the little moments and once-in-a-lifetime days into a beautifully made album you'll return to for years." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Explore the albums" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Our story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Thoughtfully made, made to be kept" },
    { "type": "image_picker", "id": "image", "label": "Hero photograph" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f5efe6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#382f27" }
  ],
  "presets": [{ "name": "Wedding hero" }]
}
{% endschema %}
