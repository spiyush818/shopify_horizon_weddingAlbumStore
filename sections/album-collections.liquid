<section class="album-collections" id="album-collections" style="--album-section-bg: {{ section.settings.background_color }};">
  <div class="album-collections__inner">
    <header class="album-collections__header">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="wedding-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      </div>
      {% if section.settings.description != blank %}<p class="album-collections__intro">{{ section.settings.description | escape }}</p>{% endif %}
    </header>
    <div class="album-collections__grid">
      {% for block in section.blocks %}
        <article class="album-card" {{ block.shopify_attributes }}>
          <a class="album-card__link" href="{{ block.settings.link | default: '#' }}" aria-label="{{ block.settings.heading | escape }}">
            <div class="album-card__image-wrap">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    alt: block.settings.image.alt,
                    class: 'album-card__image',
                    loading: 'lazy'
                }}
              {% else %}
                <div class="album-card__placeholder album-card__placeholder--{{ forloop.index | modulo: 3 | plus: 1 }}" role="img" aria-label="Add an album photograph in the theme editor">
                  <span class="album-card__book" aria-hidden="true"></span>
                </div>
              {% endif %}
              <span class="album-card__arrow" aria-hidden="true">↗</span>
            </div>
            {% if block.settings.eyebrow != blank %}<p class="album-card__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
            {% if block.settings.description != blank %}<p class="album-card__description">{{ block.settings.description | escape }}</p>{% endif %}
            {% if block.settings.link_label != blank %}<span class="album-card__label">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></span>{% endif %}
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .album-collections { padding: clamp(64px, 9vw, 124px) clamp(20px, 6vw, 88px); background: var(--album-section-bg); }
  .album-collections__inner { max-width: 1440px; margin: 0 auto; }
  .album-collections__header { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
  .album-collections__header .wedding-eyebrow { margin-bottom: 14px; color: #80694f; }
  .album-collections__header h2 { max-width: 650px; margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(36px, 4vw, 56px); font-weight: 400; letter-spacing: -.045em; line-height: 1.08; }
  .album-collections__intro { max-width: 225px; margin: 0 0 5px; font-size: 13px; line-height: 1.7; opacity: .72; }
  .album-collections__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 36px); }
  .album-card__link { display: block; color: inherit; text-decoration: none; }
  .album-card__image-wrap { position: relative; overflow: hidden; aspect-ratio: 4 / 4.7; background: #e8dfd3; }
  .album-card__image { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .album-card__link:hover .album-card__image { transform: scale(1.035); }
  .album-card__placeholder { display: grid; place-items: center; width: 100%; height: 100%; background: linear-gradient(145deg, #e8d8c4, #c8b29a); }
  .album-card__placeholder--2 { background: linear-gradient(145deg, #d4c8b9, #efe5d8); }
  .album-card__placeholder--3 { background: linear-gradient(145deg, #dac7b6, #b59c83); }
  .album-card__book { width: 40%; height: 54%; border: 1px solid rgb(255 255 255 / 65%); background: linear-gradient(130deg, rgb(255 255 255 / 34%), rgb(103 75 49 / 16%)); box-shadow: 13px 15px 26px rgb(68 46 27 / 12%); transform: rotate(-5deg); }
  .album-card__arrow { position: absolute; top: 16px; right: 16px; width: 38px; height: 38px; display: grid; place-items: center; background: #f8f4ec; border-radius: 50%; font-size: 16px; transition: transform .2s ease; }
  .album-card__link:hover .album-card__arrow { transform: rotate(45deg); }
  .album-card__eyebrow { margin: 25px 0 8px; color: #80694f; font-size: 9px; font-weight: 600; letter-spacing: .17em; }
  .album-card h3 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(23px, 2.1vw, 30px); font-weight: 400; letter-spacing: -.025em; }
  .album-card__description { max-width: 370px; margin: 10px 0 18px; font-size: 12px; line-height: 1.75; opacity: .72; }
  .album-card__label { display: inline-flex; gap: 10px; align-items: center; border-bottom: 1px solid rgb(56 47 39 / 45%); padding-bottom: 5px; font-size: 11px; }
  @media (max-width: 749px) {
    .album-collections { padding: 62px 20px; }
    .album-collections__header { display: block; margin-bottom: 30px; }
    .album-collections__intro { margin-top: 15px; }
    .album-collections__grid { grid-template-columns: 1fr; gap: 34px; }
    .album-card__image-wrap { aspect-ratio: 1 / 1.03; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Album collections",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A PLACE FOR EVERY CHAPTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to hold your most meaningful moments" },
    { "type": "textarea", "id": "description", "label": "Intro text", "default": "Choose a story to begin." },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fbf8f3" }
  ],
  "blocks": [
    {
      "type": "album",
      "name": "Album card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photograph" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE WEDDING ALBUM" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Your day, beautifully told" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Gather every detail of your celebration in one timeless place." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover the album" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Album collections",
      "blocks": [
        { "type": "album" },
        { "type": "album" },
        { "type": "album" }
      ]
    }
  ]
}
{% endschema %}
